' Interfacing between services and their contracts
IngredientService ..|> IIngredientService
DishService ..|> IDishService
MenuService ..|> IMenuService
CustomerService ..|> ICustomerService
OrderService ..|> IOrderService
LoyaltyService ..|> ILoyaltyService

' Each service uses DTOs in its corresponding logical group
IngredientService ..> MIngredient : DTO
DishService ..> MDish : DTO
MenuService ..> MMenu : DTO
CustomerService ..> MCustomer : DTO
OrderService ..> MOrder : DTO
LoyaltyService ..> MLoyalty : DTO
AutomapperProfile ..> MRoot : maps

' The three actual DTO-to-DTO collection properties
DishDto --> "0..*" IngredientDto : Ingredients
OrderDto --> "0..*" OrderItemDto : Items
UpdateLoyaltyLevelsDto --> "0..*" UpdateLoyaltyLevelDto : Levels

' Central business dependencies
OrderService ..> ILoyaltyService
OrderService ..> OrderPricing
LoyaltyService ..> LoyaltyPolicyValidator
LoyaltyService ..> OrderPricing
LoyaltyPolicyValidator ..> OrderPricing
RestaurantException --> RestaurantErrorType

' Alignment controls: one row for each service/contract/DTO group
IIngredientService -[hidden]- IDishService
IngredientService -[hidden]- DishService
MIngredient -[hidden]- MDish
IDishService -[hidden]- IMenuService
DishService -[hidden]- MenuService
MDish -[hidden]- MMenu
IMenuService -[hidden]- ICustomerService
MenuService -[hidden]- CustomerService
MMenu -[hidden]- MCustomer
ICustomerService -[hidden]- IOrderService
CustomerService -[hidden]- OrderService
MCustomer -[hidden]- MOrder
IOrderService -[hidden]- ILoyaltyService
OrderService -[hidden]- LoyaltyService
MOrder -[hidden]- MLoyalty
@enduml
